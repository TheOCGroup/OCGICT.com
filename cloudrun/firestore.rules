rules_version = '2';
// G fallback data posture: ALL access is server-side through the Admin SDK
// (IAM-governed, bypasses these rules). No client SDK access is ever
// intended, so the rules deny everything — a misconfigured client key or a
// stray web app can neither read nor write the counters or leads.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
